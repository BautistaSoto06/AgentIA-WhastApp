# Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_webhook
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Logging
LOG_LEVEL=info

# Application
APP_NAME=WhatsApp-Webhook-Handler

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
