# Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_webhook
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Logging
LOG_LEVEL=info

# Application
APP_NAME=WhatsApp-Webhook-Handler

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Message Burst Aggregation
# BURST_WINDOW_MS: time window after last message before processing burst (10s default allows typing short follow-ups)
# BURST_MAX_WAIT_MS: absolute timeout from first message in burst to prevent indefinite delays (30s cap)
BURST_WINDOW_MS=10000
BURST_MAX_WAIT_MS=30000

# WhatsApp outbound (RF-04)
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v21.0
# Total attempts per message (1 = no retry) and base delay for exponential backoff
WHATSAPP_SEND_MAX_ATTEMPTS=4
WHATSAPP_SEND_BASE_DELAY_MS=500
